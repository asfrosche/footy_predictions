__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env
# Raw provider dumps and caches are regenerated, never committed.
data/raw/
data/cache/

# simulator runtime caches (regenerated, never committed)
simulator/data/raw/
simulator/data/lineup_cache/
simulator/data/provider_cache/
simulator/data/pl_form_cache.json
simulator/data/tournament_form_cache.json

# Backups of data files written by scripts/refresh_results.py
data/backups/

# Personal data kept out of git (Discord draft bot). See archive/draft_bot/.
archive/draft_bot/private/

# Local build output and dependencies (web/out is committed: Vercel serves it, see README)
web/.next/
web/node_modules/

# Written by scripts/ (live odds cache, stored model results). Regenerated, not versioned.
data/generated/*
!data/generated/fpl_players.json
!data/generated/lineups.json
!data/generated/model_predictions.json

# Third-party datasets: licence terms restrict redistribution (see data/inputs/external/MANIFEST.md)
data/inputs/external/

.vercel
.env*
